node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz.local/

# Secrets — NEVER commit these
.env
.env.local
.env.production
.env.*.local

# Scheduler state (contains user IDs)
server/.scheduler-state.json

# Voice note cache
tmp/

# Local documents (not for repo)
*.md
!README.md
!CLAUDE.md
!LAUNCH_BLOCKERS.md
!TESTING_CHECKLIST.md
!DEFECTS.md
# All docs/ markdown is tracked — this folder is project documentation, not scratch.
# (A blanket *.md ignore was silently dropping new docs from commits.)
# 2026-08-11: !docs/*.md only matches ONE level deep, so docs/p2/CALIBRATION.md was silently
# ignored and `git commit` reported "nothing to commit" — the same trap, one directory down.
# The second line covers every depth. docs/p2/README.md only escaped because !README.md
# happens to match any basename, which is luck rather than a rule.
!docs/*.md
!docs/**/*.md

# Marketing assets (local only — not for repo)
marketing/

# The standing list must survive the container it was written in (2026-08-04):
# *.md above silently untracked it, so every "committed and pushed" claim about it was false.
!OUTSTANDING.md
!LAUNCH_BLOCKERS.md
!CLAUDE.md

# Reality Test run artifacts — evidence, not source
reality-baseline-*.txt

# Hunger gauntlet run artifacts — the evidence the model saw, its reply, and the checks, tied to
# a commit SHA. Same rule: evidence, not source. Attach one to the decision it informs; the file
# exists so "Law 26 worked" can be traced to a revision and an evidence object six weeks later.
hunger-gauntlet-*.json

# P2 working directory — REAL CONVERSATIONS. Never commit these.
# The corpus is the founder's own unedited WhatsApp history: food, weight, setbacks, moods.
# It is the input to the measurement, not part of the product, and a git history is forever.
# The anchor store (docs/p2/anchors.json) IS tracked — it is the rubric, and an untracked
# rubric is folklore. That file holds only the excerpts deliberately chosen as standards.
p2-work/

# Ephemeral exact-merge-base checkout made by script/compare-unit-baseline.ts.
# It must stay under the repository so the base checkout can resolve this checkout's node_modules.
.unit-baseline-worktree-*/
