# ============================================================
# KAMLIFE COACH — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# ── DATABASE (REQUIRED) ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/kamlife

# ── OPENAI / GPT (REQUIRED for coaching) ─────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-key-here

# ── TWILIO / WHATSAPP (REQUIRED for messaging) ──────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+27xxxxxxxxx
# ── APPROVED WHATSAPP TEMPLATES (PRODUCTION ONLY) ───────────────────────────
# WhatsApp only allows freeform text within 24 hours of the CLIENT's last message.
# Outside that window every send is rejected (Twilio 63016) unless it is an
# APPROVED TEMPLATE — so until these are set, no client who was quiet yesterday
# receives a morning message, weekly check or payment alert.
#
# Get the texts to submit:  npx tsx script/template-pack.ts
# Submit in: Twilio Console → Messaging → Content Template Builder
# Then paste each approved "HX…" SID below. Sandbox has no templates — these are
# a no-op there, and when empty the behaviour is unchanged (SMS fallback).
TWILIO_DAILY_TEMPLATE_SID=
TWILIO_WEEKLY_TEMPLATE_SID=
TWILIO_PAYMENT_TEMPLATE_SID=
TWILIO_REENGAGE_TEMPLATE_SID=

# ── BETA TESTERS — comma/space-separated numbers that bypass the paywall ─────
# Any SA format works (+27…, 27…, 0… local, whatsapp:+27…). Listed numbers get a
# rolling non-expiring trial AND receive proactive messages (for frequency testing).
BETA_TESTERS=

# ── PAYFAST PAYMENTS (REQUIRED for subscriptions) ────────────
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase-if-set

# ── DASHBOARD ADMIN (REQUIRED) ──────────────────────────────
# Strong password for coach dashboard login
# MUST be set — no default. Dashboard is locked without this.
COACH_DASHBOARD_KEY=generate-a-strong-random-key-here

# ── OPTIONAL ─────────────────────────────────────────────────
# Phone number to alert when a client triggers crisis detection
COACH_ALERT_PHONE=+27xxxxxxxxx

# Public URL of the app (used for PayFast return URLs)
APP_URL=https://kamlifecoach.co.za

# WhatsApp number shown on landing page (no + prefix)
VITE_WHATSAPP_NUMBER=27xxxxxxxxx

# Landing-page hero background video (direct URL to a compressed .mp4, ideally <5MB).
# Set this RUNTIME var in Railway — the server serves it to the landing page, so the
# video appears WITHOUT a rebuild. (The older build-time VITE_HERO_VIDEO_URL still works too.)
HERO_VIDEO_URL=

# Server port (default: 5000)
PORT=5000

# Node environment
NODE_ENV=production
