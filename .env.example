# ============================================================
# KAMLIFE COACH — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values
# NEVER commit .env to git
# ============================================================

# ── DATABASE (REQUIRED) ──────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/kamlife

# ── OPENAI / GPT (REQUIRED for coaching) ─────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=sk-your-openai-key-here

# ── TWILIO / WHATSAPP (REQUIRED for messaging) ──────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+27xxxxxxxxx
# PRODUCTION ONLY — approved WhatsApp template SID ("HX…") used to re-open a chat
# when a proactive message is rejected for being outside WhatsApp's 24-hour window
# (Twilio error 63016). Leave empty on the sandbox / until you have an approved
# template; when empty the 24h-window path just falls back to SMS as before.
TWILIO_REENGAGE_TEMPLATE_SID=

# ── BETA TESTERS — comma/space-separated numbers that bypass the paywall ─────
# Any SA format works (+27…, 27…, 0… local, whatsapp:+27…). Listed numbers get a
# rolling non-expiring trial AND receive proactive messages (for frequency testing).
BETA_TESTERS=

# ── PAYFAST PAYMENTS (REQUIRED for subscriptions) ────────────
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase-if-set

# ── DASHBOARD ADMIN (REQUIRED) ──────────────────────────────
# Strong password for coach dashboard login
# MUST be set — no default. Dashboard is locked without this.
COACH_DASHBOARD_KEY=generate-a-strong-random-key-here

# ── OPTIONAL ─────────────────────────────────────────────────
# Phone number to alert when a client triggers crisis detection
COACH_ALERT_PHONE=+27xxxxxxxxx

# Public URL of the app (used for PayFast return URLs)
APP_URL=https://kamlifecoach.co.za

# WhatsApp number shown on landing page (no + prefix)
VITE_WHATSAPP_NUMBER=27xxxxxxxxx

# Server port (default: 5000)
PORT=5000

# Node environment
NODE_ENV=production
