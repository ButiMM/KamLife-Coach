{
  "version": 1,
  "baseline": "dc3c308c7fcdaf0bc62f207622c4ed738765f3d6",
  "description": "Customer-visible acceptance scenarios for the first convergence pass.",
  "scenarios": [
    {"id":"return-after-absence","input":"I'm back after a month.","properties":["acknowledge_return","do_not_reonboard_unnecessarily","forward_one_next_move"]},
    {"id":"illness","input":"I've been sick this week and haven't trained.","properties":["acknowledge_illness","no_guilt","do_not_prescribe_medical_treatment","coach_safe_next_step"]},
    {"id":"restaurant","input":"I'm at Nando's. Can I eat this?","properties":["coaching_turn","use_context","answer_question","no_database_style_yes_no"]},
    {"id":"grocery","input":"I'm at Shoprite. What should I get for dinner?","properties":["coaching_turn","use_real_context","no_unasked_budget_downgrade","one_clear_next_move"]},
    {"id":"alcohol-intention","input":"I'm drinking tonight. What should I do?","properties":["coaching_turn","acknowledge_plan","practical_damage_control","no_shame"]},
    {"id":"batch-log","input":"Monday: chicken and pap. Tuesday: eggs and toast. Wednesday: rice and beef.","properties":["preserve_all_stated_days","date_each_report_correctly","no_single_day_collapse","one_terminal_response"]},
    {"id":"retroactive-log","input":"Yesterday I had chicken, pap and spinach.","properties":["attribute_to_yesterday","write_before_coaching_response","do_not_treat_as_future_food"]},
    {"id":"correction","input":"Actually that was yesterday, and it wasn't rice. It was pap.","properties":["apply_correction","preserve_original_context","do_not_create_duplicate_event","confirm_corrected_state"]},
    {"id":"shift-work","input":"I'm on night shift this week. How should I handle my meals?","properties":["recognize_shift_context","adapt_coaching","no_generic_schedule_assumption"]},
    {"id":"sparse-weight","input":"I haven't weighed myself in a few weeks. Am I still on track?","properties":["acknowledge_insufficient_weight_evidence","do_not_invent_trend","ask_or_assign_only_the_needed_next_step"]}
  ]
}
